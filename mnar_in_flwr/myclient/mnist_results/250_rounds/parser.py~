averages = []
for i in range(5,101,5):
    with open(f"res_computed_ends_{str(i)}.txt") as readfile:
        temp = []
        for line in readfile:
            line=line.strip()
            temp.append(float(line[len("250: {'accuracy': "):-1]))
        averages.append(sum(temp)/len(temp))
print("computed")
print(averages)

