def visualize_mnist_grid(N, n_cols=5):
    """
    Displays a batch of MNIST images in a grid with predicted labels.

    Parameters:
        images (np.ndarray): Array of shape (N, 28, 28, 1)
        predict_func (callable): Function that takes a (28,28) array and returns True/False
                                 (True -> 5, False -> 3)
        n_cols (int): Number of columns in the grid
    """
    n_rows = int(np.ceil(N / n_cols))
    
    plt.figure(figsize=(n_cols * 2, n_rows * 2))
    
    for i in range(N):
        x = random.uniform(-1.0,1.0)
        y = random.uniform(-1.0,1.0)
        z_sample = np.array([[x, y]])
        image = vae.decoder.predict(z_sample, verbose=0)
        img = image[0, :, :, 0]  # Remove batch & channel dims
        label = 5 if piecewise_decide_class(x,y) else 3
        
        ax = plt.subplot(n_rows, n_cols, i + 1)
        ax.imshow(img, cmap='gray')
        ax.axis('off')
        ax.set_title(str(label), fontsize=12)
    plt.tight_layout()
    plt.show()


